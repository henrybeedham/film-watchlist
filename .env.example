# Copy to .env for local development. In Coolify, set these on the app service.

# The public URL people use to reach the app. Required in production.
# Sign-in cookies, invite links and the auth origin check use it.
BETTER_AUTH_URL=http://localhost:5173

# Secret for signing sessions (32+ characters). Optional: if empty, one is generated
# into $DATA_DIR/.auth-secret on first start and reused after that.
BETTER_AUTH_SECRET=

# TMDB credentials: a v3 API key or a v4 read access token, from
# https://www.themoviedb.org/settings/api. Optional, but without it there are no posters,
# details, release dates or streaming info, and titles are kept exactly as typed.
TMDB_API_KEY=

# Country for streaming availability and release dates (two-letter code). Default GB.
WATCH_REGION=GB

# Magnet link search (torlnk) on title pages and at /magnets. On by default; set to off to hide it.
MAGNET_SEARCH=

# Where the database, backups and generated secrets live. Default ./data (Docker: /data).
DATA_DIR=./data
